# ─────────────────────────────────────────────────────────────────────────────
# IPPO LOAN FINSERV — Environment Variables
# Copy to .env.local and fill in. .env.local is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Database (Neon / Supabase / Railway PostgreSQL)
DATABASE_URL=

# NextAuth — generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:5040

# Seed credentials for the portal admin (used by: npm run db:seed-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where new-lead alerts are sent
NOTIFICATION_EMAIL=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Verified sending domain, e.g. "Ippo Loan Finserv <noreply@ippofinserv.in>"
MAIL_FROM=

# Comma-separated IPs allowed to reach /ippo-portal. Localhost always passes.
ADMIN_ALLOWED_IPS=

# Passphrase required to soft-delete a lead from the portal
DELETE_PASSPHRASE=
